# Public address used by Caddy. DNS A/AAAA must point to this server.
DOMAIN=mailer.example.ru
TZ=Europe/Moscow

# Tilda sends this secret in WEBHOOK_API_KEY_HEADER.
WEBHOOK_API_KEY=generate-a-long-random-secret
WEBHOOK_API_KEY_HEADER=X-Webhook-Key

# Minimal admin panel: https://${DOMAIN}/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=generate-another-long-random-secret
CSRF_SECRET=generate-a-third-independent-random-secret

# Copy exact SMTP connection values from the SMTP.BZ panel.
SMTP_HOST=your-smtp-host-from-panel
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-login
SMTP_PASSWORD=your-smtp-password
SMTP_TIMEOUT_SECONDS=15

# Optional: read-only journal in /admin/logs. API key from SMTP.BZ → My profile.
SMTP_BZ_API_KEY=

DATABASE_PATH=/data/app.db
QUEUE_KEYRING_FILE=/run/secrets/queue_keyring
QUEUE_SIZE=100
QUEUE_RETENTION_SECONDS=604800
DEDUPE_RETENTION_SECONDS=604800
QUEUE_LEASE_SECONDS=300
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=3600
MAX_BODY_BYTES=1048576
